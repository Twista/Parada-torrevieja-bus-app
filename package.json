{
  "name": "torrebus",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && tsc -p functions && vite build",
    "test": "vitest run",
    "preview": "npm run build && wrangler pages dev dist --port 8788",
    "deploy": "npm run build && wrangler pages deploy dist --project-name torrebus --branch main"
  },
  "dependencies": {
    "maplibre-gl": "^6.14.0",
    "preact": "^11.0.1",
    "preact-iso": "^2.12.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
